# 阶段二 Compose 环境变量模板
# 复制为 .env 后填写真实值：Copy-Item .env.example .env
# .env 已被根目录 .gitignore 忽略（任意层级），不要提交。
#
# 本文件负责 PostgreSQL 容器初始化 + Compose 变量替换；
# Python 在宿主机运行时的 PG* 配置写在项目根目录 .env（见根 .env.example）。

# --- PostgreSQL 容器初始化 ---
# 注意：POSTGRES_* 只在数据卷为空、首次初始化时生效。
# 之后再改这里的密码不会修改数据库里已存在的角色密码。
POSTGRES_USER=weather
POSTGRES_PASSWORD=change_me_use_a_long_random_string
POSTGRES_DB=weather

# --- 宿主机端口映射 ---
# 语法 "宿主机端口:容器端口"；容器内 PostgreSQL 永远监听 5432。
# 宿主机用 127.0.0.1:5433 连接；etl 容器内用 postgres:5432。
POSTGRES_HOST_PORT=5433

# --- 时区 ---
TZ=Asia/Shanghai

# --- 宿主机上运行 python -m src.main 时 ---
# 在项目根目录 .env 中设置（不是本文件），不要改 src/ 代码：
#   PGHOST=127.0.0.1
#   PGPORT=5433                 # = POSTGRES_HOST_PORT
#   PGDATABASE=weather          # = POSTGRES_DB
#   PGUSER=weather              # = POSTGRES_USER
#   PGPASSWORD=<与 POSTGRES_PASSWORD 相同>
#
# 进程环境变量优先于 .env（config.py 用 load_dotenv(override=False)），
# 所以临时验证也可以直接 export PG*，不必改文件。
