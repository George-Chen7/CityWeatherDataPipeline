# 阶段二 Airflow 环境变量模板
# 用法：Copy-Item .env.example .env，然后逐项替换。
# .env 已被根目录 .gitignore 忽略（任意层级），不要提交。
#
# 生成密钥（PowerShell，任选一种）：
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"   # FERNET_KEY
#   python -c "import secrets; print(secrets.token_urlsafe(64))"                          # JWT / 密码
# 注意：AIRFLOW_DB_PASSWORD 会拼进 SQLAlchemy URL，只使用字母、数字、-、_。

COMPOSE_PROJECT_NAME=city-weather-airflow
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=city-weather-airflow:3.3.2

# 干净环境建议 false；如果沿用旧的元数据卷且里面已有示例 DAG，见 README 升级说明。
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Airflow Web UI 的宿主机端口（容器内固定 8080）
AIRFLOW_WEB_PORT=8080

# Airflow 元数据库（与天气业务库分离）
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow_metadata_password

# Airflow 加密与登录态签名；缺失时 compose 会直接报错，不会静默使用弱默认值
FERNET_KEY=replace_with_output_of_the_command_above
AIRFLOW__API_AUTH__JWT_SECRET=replace_with_a_long_random_string
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# 首次 airflow-init 创建的管理员
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_me_admin_password

# 天气业务库（Airflow worker/cli 使用；容器网络内地址）
# 必须与 deploy/.env 的 POSTGRES_* 保持一致：
#   WEATHER_DB_NAME     = POSTGRES_DB
#   WEATHER_DB_USER     = POSTGRES_USER
#   WEATHER_DB_PASSWORD = POSTGRES_PASSWORD
WEATHER_DB_HOST=weather-pg-stage2
WEATHER_DB_PORT=5432
WEATHER_DB_NAME=weather
WEATHER_DB_USER=weather
WEATHER_DB_PASSWORD=change_me_same_as_deploy_env

# Airflow 加入的外部 Docker 网络；默认由 deploy/docker-compose.yaml 创建。
# 仅在自定义 COMPOSE_PROJECT_NAME 或做隔离验收时覆盖。
# WEATHER_DOCKER_NETWORK=city-weather-stage2_default
