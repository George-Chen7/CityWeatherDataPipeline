# PostgreSQL 连接配置（复制为 .env 后按实际情况修改）
# 默认对应阶段一：docker run --name weather-pg ... -p 5432:5432 postgres:16.6
# 阶段二宿主机连接：PGPORT 改成 5433，PGPASSWORD 用 deploy/.env 的 POSTGRES_PASSWORD。
# 容器内的 ETL/Airflow 不用这个文件，连接参数由 Compose 显式注入。
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=weather
PGUSER=weather
PGPASSWORD=change_me

# 连接超时（秒）
PGCONNECT_TIMEOUT=5
